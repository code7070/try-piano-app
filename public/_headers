# Cloudflare Workers Static Assets headers (copied to dist/ by Vite).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), midi=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Vite emits content-hashed file names here.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Samples are not hashed: put them under a versioned folder (e.g. /samples/v1/)
# and bump the folder when any file changes.
/samples/*
  Cache-Control: public, max-age=31536000, immutable
