{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static SPA served by Workers Static Assets; no Worker script.
  "name": "piano",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Production is served only from the custom domain.
  "routes": [{ "pattern": "piano.the-friday.my.id", "custom_domain": true }],
  "workers_dev": false,
  // Non-production branches get <version>-piano.<subdomain>.workers.dev URLs.
  "preview_urls": true,
}
