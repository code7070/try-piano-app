{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static SPA served by Workers Static Assets; no Worker script.
  "name": "piano",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "workers_dev": true,
  // Non-production branches get <version>-piano.<subdomain>.workers.dev URLs.
  "preview_urls": true,
}
